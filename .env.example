# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Supabase Auth & PostgreSQL Database
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# Payoneer Payment Processing (Subscriptions & Client Payments)
# Payoneer handles all payment processing. Fee structure: card 3.99% + $0.45, bank 1%.
PAYONEER_MERCHANT_ID="your-payoneer-merchant-id"
# Client invoice checkout (hosted payment page). Auth with EITHER an API token
# (Bearer) or partner username + API password (Basic). Sandbox: point
# PAYONEER_API_BASE at https://api.sandbox.payoneer.com while testing.
PAYONEER_API_TOKEN=""
PAYONEER_PARTNER_USERNAME=""
PAYONEER_API_PASSWORD=""
PAYONEER_API_BASE="https://api.payoneer.com"
# Optional HMAC secret for /api/webhooks/payoneer server-to-server confirmations.
PAYONEER_WEBHOOK_SECRET=""
# Automatic transfers of collected client money to each agency's selected
# destination (Payoneer MassPayouts). Set PAYONEER_PROGRAM_ID to your payout
# program to enable real transfers; leave empty to record them as queued
# manual transfers instead.
PAYONEER_PROGRAM_ID=""

# Upstash QStash (Cron & Delayed Sequence Job Dispatcher)
# QSTASH_URL is the QStash API base URL (the server appends /v2/publish itself).
# IMPORTANT: QStash is a cloud service — APP_URL above must be a PUBLIC https
# URL it can call back. For local development expose the server first:
#   ngrok http 3000                      (ngrok.com, set NGROK_AUTHTOKEN once)
#   npx localtunnel --port 3000          (no account needed)
# then paste the resulting https URL into APP_URL before starting the server.
QSTASH_URL="https://qstash.upstash.io"
QSTASH_TOKEN="your-qstash-token"
QSTASH_CURRENT_SIGNING_KEY="your-qstash-current-signing-key"
QSTASH_NEXT_SIGNING_KEY="your-qstash-next-signing-key"

# AUTH_COOKIE_SECRET: HMAC secret that signs the rf_session cookie.
# Generate with: openssl rand -base64 48
# Falls back to QSTASH_CURRENT_SIGNING_KEY when unset.
AUTH_COOKIE_SECRET="your-64-char-random-secret"

# Transactional Communication Channels
RESEND_API_KEY="re_123456789"
# RESEND_FROM_EMAIL: the single verified "from" address used by EVERY outbound
# email (OTP, reminders, custom templates). Verify your domain at
# resend.com/domains first — Resend rejects unverified sender domains.
RESEND_FROM_EMAIL="reminders@youragency.com"

# WhatsApp — DIRECT Meta WhatsApp Cloud API (replaces WhAPI).
# 1. Create a Business app at developers.facebook.com with the "WhatsApp" product.
# 2. Add a phone number (WhatsApp → API Setup) and copy its PHONE NUMBER ID.
# 3. Create a System User in Business Settings → Users → System users, grant it
#    the whatsapp_business_messaging permission on your WABA, and generate a
#    PERMANENT access token (never use the temporary app token in production).
# Sends POST to https://graph.facebook.com/<version>/<PHONE_NUMBER_ID>/messages.
WHATSAPP_TOKEN="your-meta-system-user-permanent-token"
WHATSAPP_PHONE_NUMBER_ID="123456789012345"
WHATSAPP_API_VERSION="v21.0"

# SMS — EasySendSMS REST API v1 (replaces Vonage).
# Get the key from my.easysendsms.app → Account → Settings → REST API.
# EASYSENDSMS_SENDER is alphanumeric (max 11 chars) or numeric (max 15).
EASYSENDSMS_API_KEY="your-easysendsms-rest-api-key"
EASYSENDSMS_SENDER="EronFlow"

# OAuth integrations (Connectors page). Each set of client credentials turns the
# matching demo OAuth flow into a real provider redirect + token exchange.
# Gmail / Google Workspace (send reminders from the agency's real inbox)
# Create an OAuth 2.0 Client ID at console.cloud.google.com → APIs & Services →
# Credentials. Authorized redirect URI: ${APP_URL}/api/oauth/callback. Enable the
# Gmail API and add the Gmail scopes (gmail.send). After connecting, email
# reminders are sent from the user's own inbox; Resend is the automatic fallback.
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# QuickBooks Online (auto-pull unpaid invoices)
# Register webhooks in Intuit with URL: ${APP_URL}/api/webhooks/quickbooks and
# paste the webhook token below. Invoices sync through webhooks (no polling).
QUICKBOOKS_CLIENT_ID="your-quickbooks-client-id"
QUICKBOOKS_CLIENT_SECRET="your-quickbooks-client-secret"
QUICKBOOKS_WEBHOOK_TOKEN="your-quickbooks-webhook-token"

# Xero (auto-pull unpaid invoices)
# Register webhooks in Xero with URL: ${APP_URL}/api/webhooks/xero and paste the
# webhook key (base64) below. OAuth uses PKCE automatically.
XERO_CLIENT_ID="your-xero-client-id"
XERO_CLIENT_SECRET="your-xero-client-secret"
XERO_WEBHOOK_KEY="your-xero-webhook-key"

# Paddle Payment Processing (alternative to Payoneer)
# Paddle acts as merchant of record — handles VAT, tax, subscriptions & invoicing.
# 1. Create a Paddle account at paddle.com
# 2. Set up products & prices in Paddle Dashboard → Catalog
# 3. Copy the Price IDs for each plan into the env vars below
# 4. Set your Vendor ID and API Key from Paddle → Developer Tools → API Keys
# 5. Register webhook: ${APP_URL}/api/webhooks/paddle
# 6. For testing, use Paddle's sandbox mode: PADDLE_API_BASE="https://sandbox-api.paddle.com"
PADDLE_VENDOR_ID="your-paddle-vendor-id"
PADDLE_API_KEY="your-paddle-api-key"
PADDLE_CLIENT_TOKEN="your-paddle-client-token"
PADDLE_WEBHOOK_SECRET="your-paddle-webhook-secret"
PADDLE_API_BASE="https://api.paddle.com"
# Price IDs from Paddle Catalog for each subscription tier
PADDLE_PRICE_STARTER="price_starter_xxxxx"
PADDLE_PRICE_PRO="price_pro_xxxxx"
PADDLE_PRICE_AGENCY="price_agency_xxxxx"
